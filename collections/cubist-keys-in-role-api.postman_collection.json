        {
          "id": "1f3fe548-ce71-449a-82af-4b9a6f4b8224",
          "name": "Add Keys",
          "request": {
            "name": "Add Keys",
            "description": {
              "content": "Add Keys\n\nAdds a list of existing keys to an existing role.\n\nThe key owner is allowed to add their key to any role that they are in.\n\nIn \"org custody\" model only, org owners are allowed to add any key to any role.\n\nIn all cases: the role's edit policy, as well as the edit policy of each of the keys, must permit the update.\n\nEach request to this endpoint can add, at maximum, 32 keys.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v0",
                "org",
                ":org_id",
                "roles",
                ":role_id",
                "add_keys"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
