              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Update org-level policy secrets\n\nThe provided secrets will replace any existing org-level secrets.\nIt fails if the secrets weren't previously created.\n\nMust be permitted by the policy secret's edit policy if set, and the org's edit policy otherwise."
        },
