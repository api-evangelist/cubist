              {
                "name": "org_id",
                "value": "Org#124dfe3e-3bbd-487d-80c0-53c55e8ab87a",
                "type": "path",
                "description": "Name or ID of the desired Org"
              },
              {
                "name": "policy_id",
                "value": "NamedPolicy#124dfe3e-3bbd-487d-80c0-53c55e8ab87a",
                "type": "path",
                "description": "Name or ID of the desired NamedPolicy"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Update Policy\n\nUpdates the policy with the given name or id."
        },
        {
          "info": {
            "name": "Delete Policy",
            "type": "http"
