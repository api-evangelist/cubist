            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Invoke Policy\n\nInvokes the [NamedPolicy] with the given ID with the given request information.\nIt is only supported for Wasm policies."
        },
