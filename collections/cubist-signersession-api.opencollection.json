{
  "opencollection": "1.0.0",
  "info": {
    "name": "CubeSigner Account SignerSession API",
    "version": "v0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "SignerSession",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Refresh Signer Session",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://gamma.signer.cubist.dev/v1/org/:org_id/token/refresh",
            "params": [
              {
                "name": "org_id",
                "value": "Org#124dfe3e-3bbd-487d-80c0-53c55e8ab87a",
                "type": "path",
                "description": "ID of the organization owning the key"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Refresh Signer Session"
        }
      ]
    }
  ],
  "bundled": true
}