          "id": "35b5ba6a-96d0-40b8-a891-7cb9d0800897",
          "name": "Accept an invitation",
          "request": {
            "name": "Accept an invitation",
            "description": {
              "content": "Accept an invitation\n\nThis endpoint allows idp users to register using a token they have received in their email",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v0",
                "org",
                ":org_id",
                "invitation",
                "accept"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "org_id",
                  "description": "(Required) Name or ID of the desired Org"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<string>\",\n  \"auth\": {\n    \"kind\": \"<string>\",\n    \"credential\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "type": "string",
      "value": "https://gamma.signer.cubist.dev",
      "key": "baseUrl"
    }
