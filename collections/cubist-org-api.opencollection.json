{
  "opencollection": "1.0.0",
  "info": {
    "name": "CubeSigner Account Org API",
    "version": "v0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Org",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Email Template",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gamma.signer.cubist.dev/v0/org/:org_id/emails/:purpose",
            "params": [
              {
                "name": "org_id",
                "value": "Org#124dfe3e-3bbd-487d-80c0-53c55e8ab87a",
                "type": "path",
                "description": "Name or ID of the desired Org"
              },
              {
                "name": "purpose",
                "value": "",
                "type": "path",
                "description": "Which email configuration to get"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get Email Template\n\nReturns the email template for a given purpose."
        },
        {
          "info": {
            "name": "Configure Email Template",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://gamma.signer.cubist.dev/v0/org/:org_id/emails/:purpose",
            "params": [
              {
                "name": "org_id",
                "value": "Org#124dfe3e-3bbd-487d-80c0-53c55e8ab87a",
                "type": "path",
                "description": "Name or ID of the desired Org"
              },
              {
                "name": "purpose",
                "value": "",
                "type": "path",
                "description": "Which email to configure"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Configure Email Template"
        },
        {
          "info": {
            "name": "Delete Email Template",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://gamma.signer.cubist.dev/v0/org/:org_id/emails/:purpose",
            "params": [
              {
                "name": "org_id",
                "value": "Org#124dfe3e-3bbd-487d-80c0-53c55e8ab87a",
                "type": "path",
                "description": "Name or ID of the desired Org"
              },
              {
                "name": "purpose",
                "value": "",
                "type": "path",
                "description": "Which email configuration to delete"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Delete Email Template"
        }
      ]
    }
  ],
  "bundled": true
}